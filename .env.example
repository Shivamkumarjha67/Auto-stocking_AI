# AutoStock-AI Environment Configuration

# -------------------------------------------------------------
# ENGINE 1: Mistral AI Cloud Engine (Default / Quickstart)
# -------------------------------------------------------------
# Required for dense embeddings (mistral-embed) and cloud inference
MISTRAL_API_KEY=your_mistral_api_key_here

# -------------------------------------------------------------
# ENGINE 2: Fine-Tuned LLaMA 3.2 3B Engine (Google Colab / Edge)
# -------------------------------------------------------------
# Set USE_LOCAL_MODEL=true to route PO reasoning to your fine-tuned model.
# For Google Colab + ngrok: paste your public ngrok URL (e.g., https://xxxx.ngrok-free.app/v1)
# For local vLLM / Ollama: use http://localhost:8000/v1
USE_LOCAL_MODEL=true
LOCAL_LLM_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=procurement-llama-finetuned
VLLM_BASE_URL=https://brewing-crevice-deflator.ngrok-free.dev/v1


# -------------------------------------------------------------
# Database & Vector Store Configuration
# -------------------------------------------------------------
DATABASE_PATH=data/mock_db/warehouse.db
CHROMA_PERSIST_DIRECTORY=data/chroma_db


